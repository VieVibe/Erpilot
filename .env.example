# 复制为 .env 并填入（.env 已被 gitignore，不要提交真实密钥）

# 模型供应商预设（agent_core LLMConfig.from_env）：zhipu（默认）/ deepseek / qwen
# 切换只需改 LLM_PROVIDER，并填入对应供应商的 API key；base_url/model 仍可用下方 env 覆盖。
LLM_PROVIDER=zhipu

# 智谱开放平台：https://open.bigmodel.cn （模型 ID 以控制台为准）
ZHIPU_API_KEY=
# DeepSeek：https://platform.deepseek.com （LLM_PROVIDER=deepseek 时读取）
DEEPSEEK_API_KEY=
# 阿里云百炼 DashScope（Qwen，OpenAI 兼容模式）：LLM_PROVIDER=qwen 时读取
DASHSCOPE_API_KEY=

# 可选：覆盖所选供应商预设的端点 / 模型（第三方中转端点记得带 /v1/ 后缀）
# LLM_API_KEY 可覆盖供应商密钥，适用于同一中转 key 切换多个模型。
# LLM_API_KEY=
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
# LLM_MODEL=glm-5.3-flash
# 当前中转端点支持同 key 切换 deepseek-v4.1-flash（2026-10-12 用户确认）。
# 保留当前 LLM_PROVIDER / LLM_BASE_URL / key，仅覆盖 LLM_MODEL。
# 此说明不代表智谱官方端点支持该模型；中转计费记录见 B5 设计规格。
# LLM_MODEL=deepseek-v4.1-flash

# 政策嵌入与聊天模型独立；当前政策索引使用以下模型，密钥需单独填写。
EMBED_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
EMBED_MODEL=qwen3.7-text-embedding-flash
EMBED_API_KEY=
# 不回退到其他供应商的聊天密钥。
EMBED_API_KEY_ENV=EMBED_API_KEY
# 改嵌入模型后须重新 rag build 并校准检索阈值，不能混用旧向量。

# Normal real API uses local SQLite ERP through MCP; tests can inject alternate tools.
ERPILOT_TOOLS=mcp
ERPILOT_WRITES=0
# Order intent rollout: off (legacy), shadow (local diagnostics), enforce (draft rules/state).
# Real API defaults to enforce; deterministic rules first, model proposals on unresolved input.
ERPILOT_INTENT_MODE=enforce
ERPILOT_SEMANTIC=1
# Persistent proposal-only budget; normal business chat is independent of this quota.
ERPILOT_SEMANTIC_BUDGET=1.00
ERPILOT_SEMANTIC_MAX_REQUESTS=200
ERPILOT_SEMANTIC_TIMEOUT=60
ERPILOT_SEMANTIC_BUDGET_ID=default-semantic-v1
# For an endpoint without a recorded price, supply explicit native-currency rates:
# ERPILOT_SEMANTIC_CURRENCY=CNY
# ERPILOT_SEMANTIC_INPUT_PER_M=
# ERPILOT_SEMANTIC_OUTPUT_PER_M=

# Forward provider reasoning_content when available; no synthetic thinking text.
ERPILOT_THINKING=1

# Langfuse 自托管（M3 接入可观测时再填）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# Required for API graph state; ERP business data / RunStore stay in SQLite.
# Local Docker demo only; never use these credentials in production.
ERPILOT_CHECKPOINT_DATABASE_URL=postgresql://erpilot:erpilot_local@localhost:5433/erpilot

# Local API identity is optional; the authenticated container entry always requires it.
# ERPILOT_AUTH=1
# ERPILOT_RUN_STORE_PATH=data/runs.db
# With a same-origin HTTPS proxy, enable Secure cookies; local HTTP must leave this off.
# ERPILOT_COOKIE_SECURE=1
